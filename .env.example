# ────────────────────────────────────────────────────────────────────────────────
# Nyayadarsi Environment Configuration
# Copy this file to .env and fill in your actual values
# ────────────────────────────────────────────────────────────────────────────────

# ── AI API Keys ──────────────────────────────────────────────────────────────────
# At least one AI provider is required for text extraction features
GEMINI_API_KEY=your_gemini_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ── Database Configuration ───────────────────────────────────────────────────────
# Examples:
#   SQLite:    sqlite:///./nyayadarsi.db
#   PostgreSQL: postgresql+psycopg://user:password@localhost:5432/nyayadarsi
#   MySQL:     mysql+pymysql://user:password@localhost:3306/nyayadarsi
DATABASE_URL=sqlite:///./nyayadarsi.db

# ── JWT Authentication ──────────────────────────────────────────────────────────
# ⚠️  IMPORTANT: Generate a strong secret for production using:
#     python -c "import secrets; print(secrets.token_hex(32))"
# Never commit the actual secret to version control!
JWT_SECRET_KEY=nyayadarsi-dev-secret-CHANGE-BEFORE-DEPLOYING-32chars+
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── GPS Verification Configuration ──────────────────────────────────────────────
# Registered site coordinates (default: Bhubaneswar, India)
REGISTERED_SITE_LAT=20.2961
REGISTERED_SITE_LON=85.8245
# Distance threshold in meters
GPS_THRESHOLD_METERS=100.0

# ── Application Configuration ──────────────────────────────────────────────────
APP_VERSION=2.0.0
APP_TITLE=Nyayadarsi API
APP_DESCRIPTION=AI-Powered Procurement Justice Platform — न्यायदर्शी

# ── Frontend Configuration ───────────────────────────────────────────────────────
# URL of the backend API for frontend requests
NEXT_PUBLIC_API_URL=http://localhost:8000
